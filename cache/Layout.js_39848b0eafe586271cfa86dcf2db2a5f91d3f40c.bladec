 function inArray(needle, haystack) {
 for (var i = 0; i < haystack.length; i++) {
 if (haystack[i] === needle) {
 return true;
 }
 }
 return false;
 }



 function uang(value) {
 let val = (value / 1).toFixed(0).replace('.', ',')
 return val.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".")
 }


