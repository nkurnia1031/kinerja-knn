 function onlyNumberKey(evt) {



 // Only ASCII charactar in that range allowed

 var ASCIICode = (evt.which) ? evt.which : evt.keyCode

 if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))

 return false;

 return true;

 }

 function ensureHtml2CanvasReady() {
 if (window.html2canvas) {
 return Promise.resolve(window.html2canvas);
 }

 return new Promise((resolve, reject) => {
 const loader = document.createElement('script');
 loader.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
 loader.crossOrigin = 'anonymous';
 loader.referrerPolicy = 'no-referrer';
 loader.onload = () => resolve(window.html2canvas);
 loader.onerror = () => reject(new Error('Gagal memuat html2canvas.'));
 document.head.appendChild(loader);
 });
 }

 function buildMockupFileName(title) {
 const safeTitle = (title || 'mockup')
 .toString()
 .trim()
 .toLowerCase()
 .replace(/[^a-z0-9]+/g, '-')
 .replace(/^-+|-+$/g, '') || 'mockup';
 const stamp = new Date().toISOString().slice(0, 10);
 return `${safeTitle}-${stamp}.png`;
 }

 function downloadPngFromCanvas(canvas, fileName) {
 const link = document.createElement('a');
 link.href = canvas.toDataURL('image/png');
 link.download = fileName;
 document.body.appendChild(link);
 link.click();
 link.remove();
 }

 async function exportMockupBlock(block) {
 const html2canvasLib = await ensureHtml2CanvasReady();

 if (!block) {
 throw new Error('Area mockup tidak ditemukan.');
 }

 const title = block.dataset.mockupTitle || block.querySelector('.io-block-header span:first-child')?.textContent || 'mockup';
 const clone = block.cloneNode(true);

 const temp = document.createElement('div');
 temp.style.position = 'fixed';
 temp.style.left = '-10000px';
 temp.style.top = '0';
 temp.style.background = '#ffffff';
 temp.style.padding = '24px';
 temp.style.boxSizing = 'border-box';
 temp.style.width = `${Math.max(block.scrollWidth, block.clientWidth)}px`;
 temp.appendChild(clone);
 document.body.appendChild(temp);

 try {
 const canvas = await html2canvasLib(temp, {
 backgroundColor: '#ffffff',
 useCORS: true,
 scale: Math.min(window.devicePixelRatio || 1, 2),
 scrollX: 0,
 scrollY: -window.scrollY,
 });
 downloadPngFromCanvas(canvas, buildMockupFileName(title));
 } finally {
 temp.remove();
 }
 }

 async function exportAllMockups() {
 const blocks = document.querySelectorAll('.io-block');

 for (const block of blocks) {
 await exportMockupBlock(block);
 await new Promise((resolve) => setTimeout(resolve, 200));
 }
 }

 window.exportMockupBlock = exportMockupBlock;
 window.exportAllMockups = exportAllMockups;

 $(document).ready(function() {
 $(document).on('click', '.export-mockup-btn', async function() {
 const button = this;
 const targetId = button.dataset.mockupTarget;
 const block = document.getElementById(targetId);
 const originalText = button.textContent;

 if (!block) {
 alert('Area mockup tidak ditemukan.');
 return;
 }

 button.disabled = true;
 button.textContent = 'Mengekspor...';

 try {
 await exportMockupBlock(block);
 } catch (error) {
 alert(error.message || 'Gagal export mockup.');
 console.error(error);
 } finally {
 button.disabled = false;
 button.textContent = originalText;
 }
 });
 });
</script>

<script>
