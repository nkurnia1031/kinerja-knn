 <script src="assets/mine/html2canvas.min.js"></script>
 <script>
 // Import library

 // Select div element


 const downloadBtn2 = document.querySelector('#downloadImage');

 function downloadQr() {
 const divElement = document.querySelector('#qrCode');

 html2canvas(divElement, {
 scale: 3,
 dpi: 300 // faktor skala 2x
 }).then(canvas => {
 // Convert canvas to image data
 // mengonversi canvas ke URL gambar
 var imgData = canvas.toDataURL('image/png');

 // membuat elemen anchor untuk download
 var downloadLink = document.createElement('a');

 // menambahkan atribut download pada elemen anchor
 downloadLink.download = 'QR-Code.png';

 // mengatur URL dari elemen anchor
 downloadLink.href = imgData;

 // menambahkan elemen anchor ke dokumen
 document.body.appendChild(downloadLink);

 // mengklik elemen anchor untuk mengunduh gambar
 downloadLink.click();

 // menghapus elemen anchor dari dokumen
 document.body.removeChild(downloadLink);
 });
 }
 </script>
 <script>
 const {
 createApp
 } = Vue

 app = createApp({
 data() {
 return {
 acara: '',
 keputusan: '',
 terpilih: false,
 print: false,
 key: '',
 index: '',
 method: 'post',
 edit: false,
 tanggapan: false,
 data: '',
 fields: '',
 filter: '',
 lastQuery: '',
 ttdNotulis: null,
 ttdKetua: null,
 ttdNotulis2: '',
 ttdKetua2: '',
 tambahan: [],
 request: {
 'q': null,
 'SortBy': 'no_tag_elmot ',
 'SortWith': 'ASC',
 'limit': 1000
 },
 proses: false,
 prosesFilter: false,
 form: false,
 idTable: '#idTable',
 primary: "",
 baseURL: "Elmotion",
 datatable: null
 }
 },
 computed: {
 // a computed getter
 data2() {
 // `this` points to the component instance
 if (this.data != '') {

 return this.data.all();
 } else {
 return this.data;

 }

 },
 fields2() {
 field = null;
 // if (app.tambahan.length > 0) {
 //     if (!app.tanggapan) {
 //         field = app.tambahan.fieldsAnggota;
 //     } else {
 //         field = app.tambahan.fieldsPengurus;
 //     }
 // }

 if (this.fields != '') {
 r = this.fields;
 if (field != null) {
 r = r.whereIn('name', field);
 }
 return r.chunk(6).all();
 } else {
 return this.fields;

 }

 }
 },


 mounted() {

 this.GetData();
 <?php if(isset($_GET['id'])): ?>
 setTimeout(function() {

 let index = app.data.toArray().findIndex(item => item.id === <?php echo \htmlentities($_GET['id']??'', ENT_QUOTES, 'UTF-8', false); ?>);
 if (index !== -1) {
 app.EditData(index);
 }
 }, 1000);
 <?php endif; ?>


 },
 beforeUpdated() {


 },
 updated() {


 },
 methods: {
 onAfterEnter() {
 $('.select-elmot').select2({
 tags: true,
 theme: "bootstrap4",

 });
 $('.summernote').summernote({
 height: 350
 });
 $('.summernote').css('display', 'block');
 // $('.summernote').css('height', '1%');


 app.ttdKetua2 = '';
 app.ttdNotulis2 = '';
 // if (!app.tanggapan) {

 // } else {

 // }
 app.ttdNotulis = BikinTtd('#ttdNotulis');
 app.ttdNotulis.addEventListener("endStroke", () => {
 app.ttdNotulis2 = app.ttdNotulis.toDataURL("image/svg+xml");

 });
 app.ttdKetua = BikinTtd('#ttdKetua');
 app.ttdKetua.addEventListener("endStroke", () => {
 app.ttdKetua2 = app.ttdKetua.toDataURL("image/svg+xml");

 });
 },
 numberFormat(number, decimals = 0, decimalSeparator = ',', thousandsSeparator = '.') {
 return numberFormat(number, decimals, decimalSeparator, thousandsSeparator)
 },
 hapusDatatable() {
 if (app.datatable != null) {
 app.datatable.destroy();
 app.datatable = null;
 }
 },
 inisiasiLagi() {

 setTimeout(function() {

 if (app.ttdNotulis != null) {
 app.ttdNotulis.clear();
 }
 if (app.ttdKetua != null) {
 app.ttdKetua.clear();
 }

 app.datatable = AktifDataTable2(app.idTable);


 inisiasiAwal();
 }, 100);
 },
 inArray(needle, haystack) {
 return inArray(needle, haystack);
 },
 setPDF(pdf) {
 PDFObject.embed(pdf, "#example1");
 },
 ambilElmot() {
 if (!app.edit) {

 let elmot = $('.select-elmot').val();
 if (elmot != null) {
 axiosInstance({
 url: `/Elmotion-Get?key=` + elmot,
 })
 .then(function(response) {
 data = response.data;
 app.fields = app.fields.transform((item, key) => {
 console.log(data[item.name]);
 item.val = data[item.name] ?? '';
 return item;
 });


 })
 .catch(function(error) {
 new Toast({
 message: error + "<br>",
 type: 'danger'
 });

 });
 }
 }

 },
 onFilter() {
 this.prosesFilter = true;
 const form = document.querySelector('#form-filter');
 const formData = new FormData(form);
 const urlSearchParams = new URLSearchParams(formData);
 const queryString = urlSearchParams.toString();
 this.lastQuery = queryString;
 this.GetData("?" + queryString);
 },

 HapusData(index) {
 if (confirm("Apakah Anda yakin?")) {
 this.hapusDatatable();

 const formData = new FormData();
 const key = app.data.get(index)[app.primary];
 axiosInstance.delete(`/${this.baseURL}-CRUD?key=` + key, {})
 .then(function(response) {
 data = response.data;
 app.proses = false;
 if (data.status) {
 app.data.forget(index);
 app.filter = collect(data.data.filter);

 // _.debounce(function() {
 //         app.datatable = AktifDataTable2(app.idTable);
 //     }, 500),
 //     app.datatable = AktifDataTable2(app.idTable);
 new Toast({
 message: data.data.msg,
 type: 'success'
 });
 app.inisiasiLagi();

 } else {
 new Toast({
 message: data.data.msg,
 type: 'danger'
 });
 }

 }).catch(function(error) {
 new Toast({
 message: error,
 type: 'danger'
 });
 console.log(error);
 });

 }
 },
 GetData(request = '') {
 this.hapusDatatable();

 axiosInstance.get(`/${this.baseURL}-Api` + request, {

 })
 .then(function(response) {
 data = response.data;
 if (data.status) {
 app.fields = collect(data.data.fields);
 app.tambahan = data.data.tambahan;
 app.filter = collect(data.data.filter);
 app.data = collect(data.data.data);
 app.primary = data.data.primary;
 app.request = data.data.request;

 app.inisiasiLagi();


 } else {
 new Toast({
 message: data.data.msg,
 type: 'danger'
 });
 }

 })
 .catch(function(error) {
 new Toast({
 message: error,
 type: 'danger'
 });

 });

 this.prosesFilter = false;



 },
 Tanggapan(index) {
 app.EditData(index);
 },
 Cetak(index) {
 this.index = index;
 const data = app.data.get(index);
 this.terpilih = data;




 setTimeout(function() {
 var target = $('#datetime');
 if (target.length) {
 $('html, body').stop().animate({
 scrollTop: target.offset().top

 }, 1000);
 }

 app.print = true;
 setTimeout(function() {
 JsBarcode("#" + "qrCode", "" + data.no_tag_elmot + "", {
 width: 2, // ketebalan garis (bukan total width)
 height: 57, // px ~ 1.5 cm
 });

 // new QRCode(document.getElementById("qrCode"), {
 //     text: "" + data.id + "",
 //     width: 500,
 //     height: 500,
 //     colorDark: "#000000",
 //     colorLight: "#ffffff",
 //     correctLevel: QRCode.CorrectLevel.H
 // });
 // $('#qrCode').append(
 //     '<h3 class="mb-0 pb-0 mt-2" style="color:black"><strong>' +
 //     data.no_tag_elmot + '</strong></h3>'
 // )
 }, 500);

 }, 100);

 },
 EditData(index) {
 this.index = index;
 const data = app.data.get(index);
 this.key = data[this.primary];
 this.fields = this.fields.transform((item, key) => {
 item.val = data[item.name];
 return item;
 });
 this.form = true;
 this.edit = true;

 setTimeout(function() {
 var target = $('#atas');
 if (target.length) {
 $('html, body').stop().animate({
 scrollTop: target.offset().top
 }, 1000);
 }
 }, 100);

 },
 setAcara(index) {
 const data = app.data.get(index);
 app.acara = data.acara;
 app.keputusan = data.acara;
 $('#example1-acara').html(app.acara);
 $('#example1-keputusan').html(app.keputusan);
 },
 onSubmit(event) {
 this.hapusDatatable();
 this.proses = true;
 const form = document.querySelector('#form-input');

 // Membuat objek FormData
 const formData = new FormData(form);
 // Mengirim request dengan axios
 const fileInput = document.getElementById('lampiran1');
 if (fileInput != null) {
 if (fileInput.files[0] != undefined) {
 formData.append('input[lampiran]', fileInput.files[0]);
 }
 }

 if (this.edit) {
 formData.append('update', true);

 }
 axiosInstance({
 method: this.method,
 url: `/${this.baseURL}-CRUD`,
 data: formData
 })
 .then(function(response) {
 data = response.data;
 app.proses = false;
 if (data.status) {
 if (app.edit) {
 app.form = false;
 app.edit = false;
 var hasil = app.data.get(app.index);
 for (let index = 0; index < app.fields.count(); index++) {
 var fieldnya = app.fields.get(index);
 hasil[fieldnya.name] = data.data.data[fieldnya.name];
 // console.log(fieldnya.name, fieldnya.val);

 }

 } else {
 app.data.push(data.data.data);

 }
 app.filter = collect(data.data.filter);
 $('#form-input').trigger('reset');
 app.fields = app.fields.transform((item, key) => {
 item.val = "";
 return item;
 });
 app.GetData();

 new Toast({
 message: data.data.msg,
 type: 'success'
 });




 } else {
 new Toast({
 message: data.data.msg,
 type: 'danger'
 });
 }

 })
 .catch(function(error) {
 new Toast({
 message: error + "<br>",
 type: 'danger'
 });

 });





 }
 }
 }).mount('#app')
 </script>
