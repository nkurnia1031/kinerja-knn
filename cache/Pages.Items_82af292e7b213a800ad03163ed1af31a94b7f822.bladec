<div class="form-group ">
 <label class="font-weight-bold col-form-label "><i class="fa fa-boxes"></i> Items</label>
 <form @submit.prevent="onSubmit">
 <div class="card table-responsive shadow-sm">
 <table class="table text-nowrap table-striped  w-100" id="tb-barang">
 <thead class="text-center">
 <tr>
 <th>Produk</th>
 <th>Qty</th>
 <th>Harga</th>
 <th>Total</th>
 <th>Keterangan</th>
 <th>Aksi</th>
 </tr>
 </thead>
 <tbody>
 <tr class="text-center" v-for="(i,index) in data2">
 <td class="text-left text-wrap">
 <a href="javascript:;" @click="ViewProduk(i.produk_id)" class="text-nowrap">
 {{ i.produk_nama }}</a>
 </td>
 <td class=" text-wrap">
 <span class="text-nowrap"> {{ i.qty }}</span>
 </td>
 <td class=" text-wrap">
 <span class="text-nowrap"> Rp {{ numberFormat(i.harga) }}</span>
 </td>
 <td class=" text-wrap">
 <span class="text-nowrap"> Rp {{ numberFormat(i.total) }}</span>
 </td>
 <td class=" text-wrap">
 <pre class="text-left text-nowrap" v-html="i.ket"></pre>

 </td>

 <td>
 <div class="d-none d-sm-block">
 <a v-bind:onclick="'appTransaksiInstance.HapusData('+index+')'" data-placement="top"
 title="Data Akan dihapus selamanya" href="javascript:;"
 class="shadow  text-danger mx-1 my-1"><i class="fa fa-trash"></i></a>



 </div>
 </td>



 </tr>

 </tbody>
 <tfoot>

 <tr>
 <th>
 <input type="hidden" name="input[transaksi_id]" v-bind:value="transaksi_id">
 <select v-model="fieldProduk.val" class="form-control select"
 data-placeholder="Pilih Produk" :id="fieldProduk.name + '1'" :required="fieldProduk.req"
 :name="'input[' + fieldProduk.name + ']'">
 <option value=""></option>
 <option v-for="i in tambahan.produk" :value="i.id">
 {{ i.nama }}</option>
 </select>

 </th>
 <th>
 <input type="number" min="1" v-model="fieldQty.val" class="form-control "
 :id="fieldQty.name + '1'" :required="fieldQty.req"
 :name="'input[' + fieldQty.name + ']'">
 </th>
 <th>
 <input type="number" min="1" v-model="fieldHarga.val" class="form-control "
 :id="fieldHarga.name + '1'" :required="fieldHarga.req"
 :name="'input[' + fieldHarga.name + ']'">
 </th>
 <th class="text-center">
 Rp {{ numberFormat(fieldQty.val * fieldHarga.val) }}
 </th>
 <th>
 <input type="text" min="1" v-model="fieldKet.val" class="form-control "
 :id="fieldKet.name + '1'" :required="fieldKet.req"
 :name="'input[' + fieldKet.name + ']'">
 </th>
 <th>
 <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-plus"></i>
 Tambah</button>
 </th>

 </tr>
 <tr>
 <th colspan="3">Total</th>
 <th class="text-center">Rp {{ numberFormat(totalHarga) }} <br>
 <span class="text-warning">( -<?php echo \htmlentities(number_format($data['key']->diskon)??'', ENT_QUOTES, 'UTF-8', false); ?>)</span>
 </th>
 <th colspan="2">
 <strong>Rp
 {{ numberFormat(totalHarga - diskon) }}</strong>
 </th>
 </tr>
 </tfoot>

 </table>
 </div>
 </form>


