 <?php $__currentLoopData = ['jenis', 'tanggal', 'catatan']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <div class="form-group ">
 <label class="font-weight-bold col-form-label "><?php echo \htmlentities(ucfirst($item)??'', ENT_QUOTES, 'UTF-8', false); ?></label>
 <p class="mb-0"><?php echo \htmlentities($data['key']->$item??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <div class="col-lg-6 col-12 border-left-dark">
