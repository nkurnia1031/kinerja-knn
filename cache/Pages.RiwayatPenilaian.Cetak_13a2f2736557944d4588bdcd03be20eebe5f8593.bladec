 <th width="15%">Nilai</th>
 <th width="15%">Nilai x Bobot</th>
 <th width="15%">Keterangan</th>
 </tr>
 </thead>
 <tbody>
 <?php  $no = 1;  ?>
 <?php $__currentLoopData = $data['detail'] ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $detail): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($no++??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="kriteria-nama"><?php echo \htmlentities($detail->nama_kriteria??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($detail->bobot??'', ENT_QUOTES, 'UTF-8', false); ?>%</td>
 <td><?php echo \htmlentities($detail->nilai??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(number_format($detail->nilai_bobot, 2)??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php  $persentaseNilai = ($detail->nilai / 4) * 100;  ?>
 <?php if($persentaseNilai >= 90): ?> Sangat Baik
 <?php elseif($persentaseNilai >= 80): ?> Baik
 <?php elseif($persentaseNilai >= 70): ?> Cukup
 <?php elseif($persentaseNilai >= 60): ?> Kurang
 <?php else: ?> Sangat Kurang
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 <tfoot>
 <tr class="total-row">
 <td colspan="4" style="text-align: right;">TOTAL NILAI</td>
 <td><?php echo \htmlentities($data['penilaian']->total_nilai ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php 
 $klasifikasi = $data['penilaian']->klasifikasi ?? '-';
 $kelasKlasifikasi = '';
 if ($klasifikasi == 'Sangat Baik') $kelasKlasifikasi = 'sangat-baik';
 elseif ($klasifikasi == 'Baik') $kelasKlasifikasi = 'baik';
 elseif ($klasifikasi == 'Cukup') $kelasKlasifikasi = 'cukup';
 elseif ($klasifikasi == 'Kurang') $kelasKlasifikasi = 'kurang';
 else $kelasKlasifikasi = 'sangat-kurang';
 ?>
 <span class="klasifikasi <?php echo \htmlentities($kelasKlasifikasi??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($klasifikasi??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 </tr>
 </tfoot>
 </table>

