<script>
 if (window.appTransaksiView) {
 window.appTransaksiView.unmount()
 }


 window.appTransaksiView = createApp({
 components: components,
 data() {
 data = dataAwal();
 data.baseURL = 'TransaksiLine';
 data.idTable = 'tb-barang';
 data.diskon = <?php echo \htmlentities($data['key']->diskon??'', ENT_QUOTES, 'UTF-8', false); ?>;
 data.transaksi_id = <?php echo \htmlentities($data['key']->transaksi_id??'', ENT_QUOTES, 'UTF-8', false); ?>;
 data.fieldholder = {
 name: '',
 label: '',
 type: 'text',
 req: false,
 max: '',
 val: '',
 pnj: 12,
 small: ''
 };

 return data;
 },
 watch: {
 'fieldProduk.val'(newVal, oldVal) {
 var harga = '<?php echo \htmlentities($data['key']->harga??'', ENT_QUOTES, 'UTF-8', false); ?>';

 var yis = collect(this.tambahan.produk);
 var produk = yis.where('id', Number(newVal)).first();
 if (produk) {
 this.fieldHarga.val = produk[harga];
 } else {
 this.fieldHarga.val = 0;
 }
 console.log(produk);
 console.log('produk berubah:', oldVal, '→', newVal)
 }
 },
 computed: {
 ...computedAwal,
 totalHarga() {
 let total = 0;
 if (!this.data2) return total;
 this.data2.forEach(i => {
 total += parseFloat(i.total);
 });
 return total;
 },
 fieldProduk() {
 if (!this.fields) return this.fieldholder;
 return this.fields.where('name', 'produk_id').first();
 },
 fieldQty() {
 if (!this.fields) return this.fieldholder;
 return this.fields.where('name', 'qty').first();
 },
 fieldHarga() {
 if (!this.fields) return this.fieldholder;
 return this.fields.where('name', 'harga').first();
 },
 fieldKet() {
 if (!this.fields) return this.fieldholder;
 return this.fields.where('name', 'ket').first();
 }

 },
 mounted() {
 this.lastQuery = 'transaksi_id[]=' + this.transaksi_id;
 this.GetData();
 setTimeout(() => {
 this.onAfterEnter();
 }, 500);
 },
 beforeUpdated() {},
 updated() {},
 methods: {
 ...methodAwal,

 }
 });
 appTransaksiInstance = window.appTransaksiView.mount('#modal-contact');
</script>
