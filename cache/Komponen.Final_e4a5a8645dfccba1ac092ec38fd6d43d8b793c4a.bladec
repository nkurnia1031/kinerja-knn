<?php if($data->jenis == 'Pembelian'): ?>
 <span class="text-nowrap text-danger"> Rp <?php echo \htmlentities(number_format($data->$v)??'', ENT_QUOTES, 'UTF-8', false); ?></span>
<?php else: ?>
 <span class="text-nowrap text-success"> Rp <?php echo \htmlentities(number_format($data->$v)??'', ENT_QUOTES, 'UTF-8', false); ?></span>
<?php endif; ?>
