<script>
 if (window.appDevice) {
 window.appDevice.unmount()
 }
 window.appDevice =
 createApp({
 data() {
 data = dataAwal();
 data.baseURL = 'Device';
 data.idTable = null;
 return data;
 },
 computed: computedAwal,
 mounted() {
 this.GetData();
 },
 beforeUpdated() {},
 updated() {},
 methods: {
 ...methodAwal,
 afterGetdata() {
 setTimeout(() => {
 if ($('.select-device').length) {
 $('.select-device').select2({
 theme: "bootstrap4",
 tags: true,

 });
 }
 }, 500);
 app.tambahan['device'] = this.data;
 },

 }
 });

 appDeviceInstance = window.appDevice.mount('#modal-contact<?php echo \htmlentities($data['num']??'', ENT_QUOTES, 'UTF-8', false); ?>');
 $('.resetnya').click(function(e) {
 $('#modal-contact<?php echo \htmlentities($data['num']??'', ENT_QUOTES, 'UTF-8', false); ?>').modal('hide');

 });
</script>
