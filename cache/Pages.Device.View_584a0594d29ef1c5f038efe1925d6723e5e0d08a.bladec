<div class="modal fade" id="modal-contact2" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
 aria-hidden="true">
 <div class="modal-dialog modal-md" role="document">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title h6">View Device</h5>
 <button type="button" class="close" data-dismiss="modal" aria-label="Close">
 <span aria-hidden="true">&times;</span>
 </button>
 </div>
 <div class="modal-body">
 <div class="row">

 <?php $__currentLoopData = $data['device']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <?php if(in_array($item['label'], ['Foto Produk'])): ?>
 <div class="form-group col-12">
 <label class="font-weight-bold col-form-label "><?php echo \htmlentities($item['label']??'', ENT_QUOTES, 'UTF-8', false); ?></label>
 <br>
 <img src="upload/<?php echo \htmlentities($item['val']??'', ENT_QUOTES, 'UTF-8', false); ?>" width="200" alt="">
 </div>
 <?php elseif(in_array($item['label'], ['Harga Modal', 'Harga Jual'])): ?>
 <div class="form-group col-6">
 <label class="font-weight-bold col-form-label "><?php echo \htmlentities($item['label']??'', ENT_QUOTES, 'UTF-8', false); ?></label>
 <p class="mb-0">Rp <?php echo \htmlentities(number_format($item['val'])??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <?php elseif(in_array($item['label'], ['Apakah Jasa?'])): ?>
 <div class="form-group col-6">
 <label class="font-weight-bold col-form-label "><?php echo \htmlentities($item['label']??'', ENT_QUOTES, 'UTF-8', false); ?></label>
 <p class="mb-0"><?php echo \htmlentities($item['val'] ? 'Ya' : 'Tidak'??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <?php else: ?>
 <div class="form-group col-6">
 <label class="font-weight-bold col-form-label "><?php echo \htmlentities($item['label']??'', ENT_QUOTES, 'UTF-8', false); ?></label>
 <p class="mb-0"><?php echo \htmlentities($item['val']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>

 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Close</button>
 </div>

 </div>
 </div>
</div>
