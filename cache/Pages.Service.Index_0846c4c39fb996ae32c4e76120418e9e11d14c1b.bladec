 <script>
 const {
 createApp
 } = Vue

 app = createApp({
 data() {
 data = dataAwal();
 data.baseURL = 'Service';
 data.perlengkapan = '';
 data.perlengkapanList = [];
 data.keluhan = '';
 data.keluhanList = [];
 data.kecualiField = ['keluhan', 'tanggal_selesai', 'tanggal_diambil', 'teknisi_id', 'status'];
 return data;
 },
 computed: computedAwal,
 mounted() {
 this.GetData();
 },
 beforeUpdated() {},
 updated() {},
 methods: {
 ...methodAwal,
 tambahanEdit(data) {
 this.perlengkapanList = [];
 this.keluhanList = [];
 if (data.perlengkapan != null) {
 this.perlengkapanList = data.perlengkapan.split('|');
 }
 if (data.keluhan != null) {
 this.keluhanList = data.keluhan.split('|');
 }

 },

 tambahList(nama) {
 if (this[nama] != '') {
 this[`${nama}List`].push(this[nama]);
 this[nama] = '';
 }
 },
 hapusList(nama, index) {
 this[`${nama}List`].splice(index, 1);
 },
 setAwal() {
 methodAwal.setAwal.call(this);
 this.perlengkapan = '';
 this.perlengkapanList = [];
 this.keluhan = '';
 this.keluhanList = [];
 },
 }
 }).mount('#app')
 </script>
 <script></script>
