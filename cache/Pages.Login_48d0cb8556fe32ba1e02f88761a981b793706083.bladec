<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('js'); ?>
 <script>
 const {
 createApp
 } = Vue

 app = createApp({
 data() {
 return {
 user: '',
 email: '',
 pass: '',
 token: '',
 reset: false,
 proses: false
 }
 },
 mounted() {
 this.renderCF();

 },
 methods: {
 renderCF() {
 app.token = '';
 turnstile.ready(function() {
 turnstile.render('#example-container', {
 sitekey: '<?php echo \htmlentities($_SERVER['CF_SITE']??'', ENT_QUOTES, 'UTF-8', false); ?>',
 theme: 'light',
 callback: function(token2) {
 app.token = token2;
 $('[data-toggle="tooltip"]').tooltip('hide')
 // console.log(`Challenge Success ${token2}`);
 },
 });
 });

 },
 onSubmit(event) {
 this.proses = true;

 axiosInstance.post('/ProsesLogin', {
 username: this.user,
 password: this.pass,
 token: this.token
 })
 .then(function(response) {
 app.proses = false;

 data = response.data;
 if (data.status) {
 new Toast({
 message: data.data.msg,
 type: 'success'
 });
 localStorage.setItem('jwt', data.data.jwt);
 setTimeout(function() {
 location.href = 'Users';
 }, 2000);

 } else {
 new Toast({
 message: data.data.msg,
 type: 'danger'
 });
 }
 app.token = '';
 turnstile.reset('#example-container');

 })
 .catch(function(error) {
 app.proses = false;
 app.token = '';

 turnstile.reset('#example-container');
 new Toast({
 message: error,
 type: 'danger'
 });
 console.log(error);
 });

 },
 toggleReset(event) {
 this.reset = !this.reset;
 setTimeout(() => {
 if (!this.reset) {
 app.renderCF();
 }

 jalanScan();
 }, 200);
 }

 }
 }).mount('#app')
 $(function() {
 $('[data-toggle="tooltip"]').tooltip()
 })
 </script>
<?php $this->stopSection(); ?>
