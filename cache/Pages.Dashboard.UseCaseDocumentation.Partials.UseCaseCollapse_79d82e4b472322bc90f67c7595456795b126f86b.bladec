<?php 
 $collapseId = 'usecase-collapse-' . $useCase['no'];
 $stepCount = count($useCase['steps']);
 ?>
<div class="card mb-3 shadow-sm">
 <div class="card-header bg-light d-flex justify-content-between align-items-center">
 <div>
 <div class="font-weight-bold text-primary">Use Case <?php echo \htmlentities($useCase['no']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($useCase['title']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <small class="text-muted"><?php echo \htmlentities($useCase['summary']??'', ENT_QUOTES, 'UTF-8', false); ?></small>
 </div>
 <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#<?php echo \htmlentities($collapseId??'', ENT_QUOTES, 'UTF-8', false); ?>" aria-expanded="false" aria-controls="<?php echo \htmlentities($collapseId??'', ENT_QUOTES, 'UTF-8', false); ?>">
 Toggle
 </button>
 </div>
 <div id="<?php echo \htmlentities($collapseId??'', ENT_QUOTES, 'UTF-8', false); ?>" class="collapse">
 <div class="card-body">
 <div class="row mb-3">
 <div class="col-md-4">
 <div class="p-3 bg-light rounded">
 <div class="text-muted small">Aktor Utama</div>
 <div class="font-weight-bold"><?php echo \htmlentities($useCase['actor']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 </div>
 <div class="col-md-4">
 <div class="p-3 bg-light rounded">
 <div class="text-muted small">Jumlah Langkah</div>
 <div class="font-weight-bold"><?php echo \htmlentities($stepCount??'', ENT_QUOTES, 'UTF-8', false); ?> langkah</div>
 </div>
 </div>
 <div class="col-md-4">
 <div class="p-3 bg-light rounded">
 <div class="text-muted small">Format</div>
 <div class="font-weight-bold">Aktor dan reaksi sistem</div>
 </div>
 </div>
 </div>

 <div class="table-responsive">
 <table class="table table-bordered table-sm mb-0">
 <thead class="thead-light">
 <tr>
 <th style="width: 5%;">No</th>
 <th style="width: 47.5%;">Aksi Aktor</th>
 <th style="width: 47.5%;">Reaksi Sistem</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $useCase['steps']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $step): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="text-center" rowspan="2"><?php echo \htmlentities($index + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($step['actor']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td></td>
 </tr>
 <tr>
 <td></td>
 <td><?php echo \htmlentities($step['system']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 </div>
 </div>
</div>
