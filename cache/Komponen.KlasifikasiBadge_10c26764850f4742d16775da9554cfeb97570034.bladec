<?php 
 $isVue = !empty($vueExpr ?? null);
 $large = !empty($large ?? false);
 $badgeSizeClass = $large ? ' badge-lg' : '';
 $text = $text ?? '-';
 $classMap = [
 'Sangat Baik' => 'success',
 'Baik' => 'primary',
 'Cukup' => 'warning',
 'Kurang' => 'danger',
 'Sangat Kurang' => 'dark',
 ];
 $badgeClass = $classMap[$text] ?? ($class ?? 'secondary');
 ?>
<?php if($isVue): ?>
 <span class="badge<?php echo \htmlentities($badgeSizeClass??'', ENT_QUOTES, 'UTF-8', false); ?>" :class="'badge-' + getKlasifikasiClass(<?php echo \htmlentities($vueExpr??'', ENT_QUOTES, 'UTF-8', false); ?>)" v-text="<?php echo \htmlentities($vueExpr??'', ENT_QUOTES, 'UTF-8', false); ?>"></span>
<?php else: ?>
 <span class="badge<?php echo \htmlentities($badgeSizeClass??'', ENT_QUOTES, 'UTF-8', false); ?> badge-<?php echo \htmlentities($badgeClass??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($text??'', ENT_QUOTES, 'UTF-8', false); ?></span>
<?php endif; ?>
